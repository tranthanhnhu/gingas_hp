# =============================================================================
# Gingas LLC - Production .htaccess
# Target: Hostinger (Apache / LiteSpeed shared hosting)
# Site type: Static multi-page HTML (no SPA rewrite needed)
# =============================================================================

# -----------------------------------------------------------------------------
# Character set (UTF-8 for Japanese / multilingual content)
# -----------------------------------------------------------------------------
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
  AddCharset UTF-8 .html .css .js .xml .txt .json
</IfModule>

# -----------------------------------------------------------------------------
# Directory behavior
# -----------------------------------------------------------------------------
# Disable directory listing when index file is missing
Options -Indexes

# Follow symlinks (required for mod_rewrite on most hosts)
<IfModule mod_rewrite.c>
  Options +FollowSymLinks
</IfModule>

# Default document
DirectoryIndex index.html index.htm

# -----------------------------------------------------------------------------
# URL routing: HTTPS, canonical host, clean URLs (no .html), legacy redirects
# -----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS (covers proxies that set X-Forwarded-Proto)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Force non-www (canonical: https://gingas.co.jp/)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # 3. Redirect visible .html URLs to extensionless (301)
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ / [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # 4. Internally serve .html for extensionless paths
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# -----------------------------------------------------------------------------
# Compression (Gzip / Brotli on LiteSpeed)
# -----------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/atom+xml
  AddOutputFilterByType DEFLATE application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf font/otf font/woff font/woff2
</IfModule>

# -----------------------------------------------------------------------------
# Browser caching for static assets
# -----------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                              "access plus 1 week"

  # HTML should always revalidate so content updates appear immediately
  ExpiresByType text/html                     "access plus 0 seconds"
  ExpiresByType application/xhtml+xml         "access plus 0 seconds"

  # SEO / feed files
  ExpiresByType application/xml               "access plus 1 hour"
  ExpiresByType text/xml                      "access plus 1 hour"

  # CSS / JS (1 year - bust cache by renaming or appending ?v=)
  ExpiresByType text/css                      "access plus 1 year"
  ExpiresByType text/javascript               "access plus 1 year"
  ExpiresByType application/javascript        "access plus 1 year"

  # Images
  ExpiresByType image/svg+xml                 "access plus 1 year"
  ExpiresByType image/webp                    "access plus 1 year"
  ExpiresByType image/avif                    "access plus 1 year"
  ExpiresByType image/jpeg                    "access plus 1 year"
  ExpiresByType image/png                     "access plus 1 year"
  ExpiresByType image/gif                     "access plus 1 year"
  ExpiresByType image/x-icon                  "access plus 1 year"

  # Fonts
  ExpiresByType font/woff2                    "access plus 1 year"
  ExpiresByType font/woff                     "access plus 1 year"
  ExpiresByType font/ttf                      "access plus 1 year"
  ExpiresByType font/otf                      "access plus 1 year"
  ExpiresByType application/font-woff2        "access plus 1 year"

  # Video
  ExpiresByType video/mp4                     "access plus 1 month"
  ExpiresByType video/webm                    "access plus 1 month"

  # Documents
  ExpiresByType application/pdf               "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  # HTML: always revalidate (avoid stale content after deploy)
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Versioned static assets: long-lived, immutable
  <FilesMatch "\.(css|js|mjs|woff2|woff|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images / media: long-lived
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ico|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>

  # Sitemap / robots / XML: short cache so search engines see updates
  <FilesMatch "\.(xml|txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

# -----------------------------------------------------------------------------
# Additional MIME types
# -----------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType font/woff2                    .woff2
  AddType font/woff                     .woff
  AddType image/svg+xml                 .svg
  AddType image/webp                    .webp
  AddType image/avif                    .avif
  AddType application/manifest+json     .webmanifest
  AddType application/json              .json
  AddType video/mp4                     .mp4
  AddType video/webm                    .webm
</IfModule>

# -----------------------------------------------------------------------------
# Security headers
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Prevent MIME-sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Control referrer information sent to other sites
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Disable unused powerful features
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"

  # Clickjacking protection (allow same-origin framing only)
  Header always set X-Frame-Options "SAMEORIGIN"

  # HSTS - enable AFTER you confirm HTTPS works on all subdomains.
  # Uncomment the line below once you are sure (1 year, include subdomains):
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Remove server fingerprint headers where possible
  Header unset X-Powered-By
</IfModule>
ServerSignature Off

# -----------------------------------------------------------------------------
# Block access to hidden / sensitive files
# -----------------------------------------------------------------------------
# Deny any dotfile (.env, .git*, .htaccess, ...) except /.well-known/ which is
# required by Let's Encrypt / ACME for SSL renewal.
<FilesMatch "^\.(?!well-known)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Block VCS folders and similar paths even if uploaded by mistake
<IfModule mod_rewrite.c>
  RewriteRule "(^|/)\.(git|svn|hg|bzr|env)(/|$)" - [F,L]
</IfModule>

# Block backup / source / config file extensions
<FilesMatch "\.(bak|backup|swp|old|orig|save|sql|log|ini|conf|sh|yml|yaml|md|lock)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# -----------------------------------------------------------------------------
# Custom error pages
# -----------------------------------------------------------------------------
ErrorDocument 404 /404.html
